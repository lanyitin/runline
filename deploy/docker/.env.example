# Copy to .env and replace every placeholder. .env is ignored by git; never commit real values.

# The database. The postgres container is created from these, and the Engine and the migration
# connect with them. POSTGRES_URL points at the compose service "postgres"; for an external
# database, change it (and drop the postgres service) without touching anything else.
POSTGRES_DB=runline
POSTGRES_USER=runline
POSTGRES_PASSWORD=change-me
POSTGRES_URL=jdbc:postgresql://postgres:5432/runline

# API tokens: name:role:token, comma separated; role is developer or admin. Generate each token
# with, for example, `openssl rand -hex 32`.
API_TOKENS=dev:developer:change-me-developer-token,ops:admin:change-me-admin-token

# Run limits: concurrent runs, bytes a run's private directory may use, and how long a failed
# run's directory is kept (seconds).
RUNLINE_MAX_CONCURRENT_RUNS=4
RUNLINE_WORKSPACE_MAX_BYTES=1073741824
RUNLINE_FAILED_RUN_RETENTION_SECONDS=86400

# Seconds a shutdown waits for requests and runs. stop_grace_period in compose.yaml is this plus 15
# (45s for 30); change them together.
RUNLINE_SHUTDOWN_GRACE_SECONDS=30

# Optional: sign-in with an OpenID Connect provider such as authentik (compose.oidc.yaml,
# deploy/authentik.md, docs/stable/oidc-login/). Off while none of these is set; setting any one of
# them makes the issuer, the client ID, the public address, the client secret and the session key
# required, and the Engine refuses to start without them.
#
# The issuer of the provider's application (authentik: https://<host>/application/o/<slug>/). The
# Engine reads the provider's discovery document from it at the first sign-in.
# RUNLINE_OIDC_ISSUER=https://authentik.example/application/o/runline/
# RUNLINE_OIDC_CLIENT_ID=change-me-client-id
# The address people type for the Engine, exactly as their browser shows it (scheme, host, port; no
# path, no trailing slash). The redirect URI registered at the provider is this plus
# /api/v1/auth/oidc/callback, and the session cookie is `Secure` exactly when this is https, also
# when TLS ends at a proxy in front of the Engine.
# RUNLINE_PUBLIC_BASE_URL=https://runline.example
#
# The client secret and the key that seals the refresh tokens kept with sessions (32 random bytes in
# base64: `openssl rand -base64 32`). Give each as a file, not as a variable: compose.oidc.yaml
# mounts the two files below as Docker secrets and sets RUNLINE_OIDC_CLIENT_SECRET_FILE and
# RUNLINE_SESSION_ENCRYPTION_KEY_FILE for the Engine (do not set those two here). Defaults, relative
# to this directory: ./secrets/oidc-client-secret and ./secrets/session-encryption-key; both
# ignored by git. A variable instead of a file works but shows in `docker inspect`:
# RUNLINE_OIDC_CLIENT_SECRET=change-me-client-secret
# RUNLINE_SESSION_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# What compose.oidc.yaml sets for the Engine (listed here for reference; leave them commented):
# RUNLINE_OIDC_CLIENT_SECRET_FILE=/run/secrets/runline_oidc_client_secret
# RUNLINE_SESSION_ENCRYPTION_KEY_FILE=/run/secrets/runline_session_encryption_key
# OIDC_CLIENT_SECRET_HOST_FILE=./secrets/oidc-client-secret
# SESSION_ENCRYPTION_KEY_HOST_FILE=./secrets/session-encryption-key
#
# Optional, with the defaults of the Engine. The claim of the ID token that lists the groups, and the
# two groups: a member of the admin group is an admin, else a member of the developer group is a
# developer, anybody else may not sign in.
# RUNLINE_OIDC_GROUPS_CLAIM=groups
# RUNLINE_OIDC_ADMIN_GROUP=runline-admin
# RUNLINE_OIDC_DEVELOPER_GROUP=runline-developer
# Sign-ins under way at once (at least 1).
# RUNLINE_OIDC_MAX_PENDING_LOGINS=200
# Seconds. A session ends after being idle that long, or after the absolute time; the idle time may
# not exceed it. The refresh token at the provider must live at least as long as the absolute time.
# RUNLINE_SESSION_IDLE_SECONDS=28800
# RUNLINE_SESSION_ABSOLUTE_SECONDS=604800
# How often a session in use is checked with the provider again (at least 10; also the longest a
# removal from a group takes to be felt), and how long a session stays valid while the provider
# cannot be reached, from the last success (0: it ends at once).
# RUNLINE_SESSION_REVALIDATE_SECONDS=60
# RUNLINE_SESSION_REVALIDATE_GRACE_SECONDS=900
#
# A provider with a private CA: the Engine's JVM must trust the root certificate
# (compose.oidc-ca.yaml, deploy/authentik.md). The host directory holding truststore.p12, made by
# deploy/bin/runline-build-truststore. Default, relative to this directory: ./truststore.
# TRUSTSTORE_HOST_DIR=./truststore

# Optional keystore of the Engine's secrets (compose.keystore.yaml, deploy/README.md): the host
# directory holding runline.p12 (mounted read-only) and the host file holding its password (a Docker
# secret). Defaults, relative to this directory: ./keystore and ./secrets/keystore-password.
# KEYSTORE_HOST_DIR=./keystore
# KEYSTORE_PASSWORD_HOST_FILE=./secrets/keystore-password

# Optional: pipelines that drive a browser (compose.browser.yaml, https://forgejo.dev.lan/runline/runline-digest-rss/src/branch/main/docs/stable/digest-rss/04-deployment.md).
# The host directory of the PEM files of the private CA's root certificates, mounted read-only; the
# whole JVM trusts them besides the JDK's. Default, relative to this directory: ./trusted-ca.
# TRUSTED_CA_HOST_DIR=./trusted-ca
# Fail the runs of the browser pipelines at their start when Chrome renders in software (default false).
# CHROME_REQUIRE_HARDWARE_RENDERING=false
# Replaces the image's CHROME_ARGS (--no-sandbox --disable-dev-shm-usage --ignore-gpu-blocklist).
# CHROME_ARGS=
# The group of /dev/dri/renderD128 on the host (stat -c %g /dev/dri/renderD128), for compose.browser-gpu.yaml.
# RENDER_GROUP_ID=

# Optional; the others are listed in docs/stable/pipeline-engine/04-deployment.md and
# engine/src/main/resources/application.yaml.
# OTEL_SERVICE_NAME=runline-engine
# OTEL_EXPORTER_OTLP_ENDPOINT=http://collector:4318

# Optional: compose.registry.yaml (an image from a registry, nothing built; deploy/browser.md). These
# are read by Compose, from the environment or from here; RUNLINE_IMAGE, RUNLINE_DATA_DIR and
# TRUSTED_CA_FILE are required there, and RENDER_GROUP_ID by compose.registry-gpu.yaml.
# ENGINE_SHM_SIZE=1gb
# ENGINE_MEM_LIMIT=
# ENGINE_CPUS=
# GPU_DEVICE=/dev/dri
