#!/bin/bash
# Makes a JVM truststore of the CA certificates of the JDK plus the certificates found in a
# directory (docs/stable/digest-rss/04-deployment.md, WI-1001). The JVM trusts that file instead of
# the JDK's own, through -Djavax.net.ssl.trustStore, so the operator's root certificates are trusted
# by the whole JVM and the public ones still are.
#
#   runline-build-truststore CA_DIR OUTPUT_FILE
#
# CA_DIR holds PEM files (*.pem, *.crt, *.cer), each with one or more certificates. OUTPUT_FILE is
# a new PKCS12 file. Exit: 0 made (also when CA_DIR holds none: the file is then a copy of the JDK's);
# 1 CA_DIR is not readable or a file in it is not a certificate (nothing is made).
#
# The password of the file is the one the JDK's own cacerts has. It protects the integrity of public
# certificates, nothing secret.
set -eu

dir="${1:?usage: runline-build-truststore CA_DIR OUTPUT_FILE}"
out="${2:?usage: runline-build-truststore CA_DIR OUTPUT_FILE}"
password="changeit"
java_home="${JAVA_HOME:-$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")}"

keytool="$java_home/bin/keytool"

[ -d "$dir" ] && [ -r "$dir" ] || { echo "runline-build-truststore: $dir is not a readable directory" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
partial="$work/truststore.p12"

"$keytool" -importkeystore -noprompt -srckeystore "$java_home/lib/security/cacerts" -srcstorepass "$password" \
  -destkeystore "$partial" -deststoretype PKCS12 -deststorepass "$password" >/dev/null 2>"$work/keytool.err" \
  || { echo "runline-build-truststore: could not copy the JDK's certificates: $(cat "$work/keytool.err")" >&2; exit 1; }

count=0
for file in "$dir"/*.pem "$dir"/*.crt "$dir"/*.cer; do
  [ -f "$file" ] || continue
  # A file may hold several certificates; keytool takes them one at a time.
  rm -f "$work"/cert-*.pem
  awk -v d="$work" '
    /-----BEGIN CERTIFICATE-----/ { n++; f = sprintf("%s/cert-%03d.pem", d, n) }
    f { print > f }
    /-----END CERTIFICATE-----/ { close(f); f = "" }
  ' "$file"
  found=0
  for cert in "$work"/cert-*.pem; do
    [ -f "$cert" ] || continue
    found=$((found + 1))
    count=$((count + 1))
    "$keytool" -importcert -noprompt -alias "runline-ca-$count" -file "$cert" \
      -keystore "$partial" -storetype PKCS12 -storepass "$password" >/dev/null 2>"$work/keytool.err" \
      || { echo "runline-build-truststore: $file is not a usable certificate: $(cat "$work/keytool.err")" >&2; exit 1; }
  done
  [ "$found" -gt 0 ] || { echo "runline-build-truststore: $file holds no PEM certificate" >&2; exit 1; }
done

mv "$partial" "$out"
echo "runline-build-truststore: $out holds the JDK's certificates and $count of $dir"
