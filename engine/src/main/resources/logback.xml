<configuration>
    <!-- Secrets the Engine knows never reach the log: message and exception are masked (WI-41). -->
    <conversionRule conversionWord="msg" converterClass="dev.lawlan.runline.engine.secret.MaskedMessageConverter"/>
    <conversionRule conversionWord="maskedEx" converterClass="dev.lawlan.runline.engine.secret.MaskedThrowableConverter"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} %property{service.name} [%thread] %-5level %logger{36} - %msg%n%maskedEx</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="org.eclipse.jetty" level="INFO"/>
    <logger name="io.netty" level="INFO"/>
</configuration>