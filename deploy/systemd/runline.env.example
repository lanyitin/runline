# Environment of the Engine, the migration and the readiness wait (docs/stable/pipeline-engine/04-deployment-systemd.md).
#
# Install as /etc/runline/runline.env, owned by root and not readable by anyone else:
#   install -d -m 0755 /etc/runline
#   install -m 0600 -o root -g root runline.env.example /etc/runline/runline.env
# then replace every placeholder. systemd reads it as root and hands the variables to the units,
# so the service account never needs to read the file.
# No variable expansion in the values.

# The database.
POSTGRES_URL=jdbc:postgresql://localhost:5432/runline
POSTGRES_USER=runline
POSTGRES_PASSWORD=change-me

# API tokens: name:role:token, comma separated; role is developer or admin. Generate each token
# with, for example, `openssl rand -hex 32`.
API_TOKENS=dev:developer:change-me-developer-token,ops:admin:change-me-admin-token

PORT=8080

# Where the artifact is installed (README: /opt/runline), and the directories the units create:
# StateDirectory=runline (persistent, the shared directories of pipelines), StateDirectory=
# runline-resources (persistent, the files of `file` shared resources) and RuntimeDirectory=runline
# (scratch, in memory: keep RUNLINE_WORKSPACE_MAX_BYTES times the concurrent runs well under it).
# The three must not be inside one another; the Engine refuses to start otherwise. Backup and
# capacity of the first two are the operator's.
RUNLINE_RUNTIME_DIR=/opt/runline/run-runtime
RUNLINE_SHARED_ROOT=/var/lib/runline
RUNLINE_RUN_ROOT=/run/runline
RUNLINE_RESOURCE_ROOT=/var/lib/runline-resources

# Run limits: concurrent runs, bytes a run's private directory may use, and how long a failed
# run's directory is kept (seconds).
RUNLINE_MAX_CONCURRENT_RUNS=4
RUNLINE_WORKSPACE_MAX_BYTES=1073741824
RUNLINE_FAILED_RUN_RETENTION_SECONDS=86400

# Seconds the whole shutdown may take: requests in flight, runs and what they give back, and
# the closing of OpenTelemetry share them; the wrap-up after them takes at most 10 seconds.
# TimeoutStopSec in runline-engine.service is this plus 15 (45s for 30); change them together.
RUNLINE_SHUTDOWN_GRACE_SECONDS=30

# Seconds the end of a run waits for its resources to be given back (a database that stops
# answering); then the run is recorded as ended and what it held stays held until the release
# ends. Not the shutdown grace above, and not used while the Engine shuts down. Optional,
# default 30.
# RUNLINE_RELEASE_WAIT_SECONDS=30

# Optional; the others are listed in docs/stable/pipeline-engine/04-deployment.md and
# engine/src/main/resources/application.yaml.
# OTEL_SERVICE_NAME=runline-engine
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Port 4318 is OTLP over HTTP; the Java SDK's own default is gRPC (port 4317). Once the endpoint is
# set, metrics are sent along with traces and logs (docs/stable/pipeline-engine/04-deployment.md).
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
