{
  "name": "runline-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The Runline Console: a static single page application that the Engine serves (ADR-015).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:api-doc": "vitest run --config vitest.apidoc.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "audit": "npm audit --audit-level=high",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.19.1",
    "jsdom": "30.1.2",
    "playwright-core": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "intl-messageformat": "12.1.3"
  }
}
