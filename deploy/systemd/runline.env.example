# Environment of the Engine, the migration and the readiness wait (docs/stable/pipeline-engine/04-deployment-systemd.md).
#
# Install as /etc/runline/runline.env, owned by root and not readable by anyone else:
#   install -d -m 0755 /etc/runline
#   install -m 0600 -o root -g root runline.env.example /etc/runline/runline.env
# then replace every placeholder. systemd reads it as root and hands the variables to the units,
# so the service account never needs to read the file.
# No variable expansion in the values.

# The database.
POSTGRES_URL=jdbc:postgresql://localhost:5432/runline
POSTGRES_USER=runline
POSTGRES_PASSWORD=change-me

# API tokens: name:role:token, comma separated; role is developer or admin. Generate each token
# with, for example, `openssl rand -hex 32`.
API_TOKENS=dev:developer:change-me-developer-token,ops:admin:change-me-admin-token

PORT=8080

# Where the artifact is installed (README: /opt/runline), and the directories the units create:
# StateDirectory=runline (persistent, the shared directories of pipelines), StateDirectory=
# runline-resources (persistent, the files of `file` shared resources) and RuntimeDirectory=runline
# (scratch, in memory: keep RUNLINE_WORKSPACE_MAX_BYTES times the concurrent runs well under it).
# The three must not be inside one another; the Engine refuses to start otherwise. Backup and
# capacity of the first two are the operator's.
RUNLINE_RUNTIME_DIR=/opt/runline/run-runtime
RUNLINE_SHARED_ROOT=/var/lib/runline
RUNLINE_RUN_ROOT=/run/runline
RUNLINE_RESOURCE_ROOT=/var/lib/runline-resources

# Run limits: concurrent runs, bytes a run's private directory may use, and how long a failed
# run's directory is kept (seconds).
RUNLINE_MAX_CONCURRENT_RUNS=4
RUNLINE_WORKSPACE_MAX_BYTES=1073741824
RUNLINE_FAILED_RUN_RETENTION_SECONDS=86400

# Seconds a shutdown waits for requests and runs. TimeoutStopSec in runline-engine.service is this
# plus 15 (45s for 30); change them together.
RUNLINE_SHUTDOWN_GRACE_SECONDS=30

# Optional: sign-in with an OpenID Connect provider such as authentik (runline-engine-oidc.conf,
# deploy/authentik.md, docs/stable/oidc-login/). Off while none of these is set; setting any one of
# them makes the issuer, the client ID, the public address, the client secret and the session key
# required, and the Engine refuses to start without them.
#
# The issuer of the provider's application (authentik: https://<host>/application/o/<slug>/).
# RUNLINE_OIDC_ISSUER=https://authentik.example/application/o/runline/
# RUNLINE_OIDC_CLIENT_ID=change-me-client-id
# The address people type for the Engine, exactly as their browser shows it (scheme, host, port; no
# path, no trailing slash). The redirect URI registered at the provider is this plus
# /api/v1/auth/oidc/callback, and the session cookie is `Secure` exactly when this is https, also
# when TLS ends at a proxy in front of the Engine.
# RUNLINE_PUBLIC_BASE_URL=https://runline.example
#
# The client secret and the key that seals the refresh tokens kept with sessions (32 random bytes in
# base64: `openssl rand -base64 32`). Give each as a file, a systemd credential: the drop-in
# runline-engine-oidc.conf loads /etc/runline/oidc-client-secret and /etc/runline/session-encryption-key
# (root:root 0600, one line) and sets RUNLINE_OIDC_CLIENT_SECRET_FILE and
# RUNLINE_SESSION_ENCRYPTION_KEY_FILE for the Engine (do not set those two here). Variables instead
# of files work but are in this file and in the environment of the process:
# RUNLINE_OIDC_CLIENT_SECRET=change-me-client-secret
# RUNLINE_SESSION_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
# What runline-engine-oidc.conf sets for the Engine (listed here for reference; leave them commented):
# RUNLINE_OIDC_CLIENT_SECRET_FILE=%d/oidc-client-secret
# RUNLINE_SESSION_ENCRYPTION_KEY_FILE=%d/session-encryption-key
#
# Optional, with the defaults of the Engine. The claim of the ID token that lists the groups, and the
# two groups: a member of the admin group is an admin, else a member of the developer group is a
# developer, anybody else may not sign in.
# RUNLINE_OIDC_GROUPS_CLAIM=groups
# RUNLINE_OIDC_ADMIN_GROUP=runline-admin
# RUNLINE_OIDC_DEVELOPER_GROUP=runline-developer
# Sign-ins under way at once (at least 1).
# RUNLINE_OIDC_MAX_PENDING_LOGINS=200
# Seconds. A session ends after being idle that long, or after the absolute time; the idle time may
# not exceed it. The refresh token at the provider must live at least as long as the absolute time.
# RUNLINE_SESSION_IDLE_SECONDS=28800
# RUNLINE_SESSION_ABSOLUTE_SECONDS=604800
# How often a session in use is checked with the provider again (at least 10; also the longest a
# removal from a group takes to be felt), and how long a session stays valid while the provider
# cannot be reached, from the last success (0: it ends at once).
# RUNLINE_SESSION_REVALIDATE_SECONDS=60
# RUNLINE_SESSION_REVALIDATE_GRACE_SECONDS=900
#
# A provider with a private CA: the JVM must trust the root certificate. Either the browser
# drop-in's RUNLINE_TRUSTED_CA_DIR (below), or a truststore made by runline-build-truststore and
# JDK_JAVA_OPTIONS (below, deploy/authentik.md).

# JVM options of the Engine (the java launcher reads JDK_JAVA_OPTIONS itself). The browser drop-in
# (runline-engine-browser.conf) sets -Djava.io.tmpdir for the Engine unit alone; the SQLite driver
# unpacks its native library into that directory, which must be writable and not mounted noexec. Do
# not set the variable here as well: this file would replace the drop-in's value, and the migration
# unit reads this file too, before the directory exists.
# JDK_JAVA_OPTIONS=
# With a provider of a private CA and no browser drop-in (deploy/authentik.md):
# JDK_JAVA_OPTIONS=-Djavax.net.ssl.trustStore=/etc/runline/truststore.p12 -Djavax.net.ssl.trustStoreType=PKCS12 -Djavax.net.ssl.trustStorePassword=changeit

# Optional: pipelines that drive a browser (runline-engine-browser.conf; docs/stable/digest-rss/04-deployment.md).
# DISPLAY=:99
# CHROME_BIN=/usr/bin/google-chrome-stable
# CHROME_ARGS=--ignore-gpu-blocklist
# Fail the runs of the browser pipelines at their start when Chrome renders in software (default false).
# CHROME_REQUIRE_HARDWARE_RENDERING=false
# Root certificates of the private CA (PEM files) that the whole JVM trusts besides the JDK's.
# RUNLINE_TRUSTED_CA_DIR=/etc/runline/trusted-ca

# Optional; the others are listed in docs/stable/pipeline-engine/04-deployment.md and
# engine/src/main/resources/application.yaml.
# OTEL_SERVICE_NAME=runline-engine
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
