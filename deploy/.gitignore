# The real environment files hold secrets; only the *.example files are versioned.
docker/.env
systemd/runline.env
# The keystore and its password file of the optional keystore overlay (docker/compose.keystore.yaml).
docker/keystore/
docker/secrets/
# The private CA's root certificates of the browser overlay (docker/compose.browser.yaml).
docker/trusted-ca/
docker/truststore/
# The VAD tool jar mounted by compose.transcribe.yaml (WI-1402); delivered by WI-1407, not part of this repository.
docker/transcribe-vad/
